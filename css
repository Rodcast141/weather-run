/* 1. Global Setup */
:root { --road-speed: 2s; }
body { 
    margin: 0; overflow: hidden; height: 100vh; 
    display: flex; justify-content: center; align-items: center;
    background: linear-gradient(to bottom, #ff9f43, #ff4e50);
    perspective: 1000px; font-family: 'Arial Black', sans-serif;
}

/* 2. The 3D Scene (Camera) */
#scene { 
    position: relative; width: 400px; height: 600px; 
    transform-style: preserve-3d; background: rgba(0,0,0,0.1);
}

/* 3. The Moving 3D Road */
#road {
    position: absolute; bottom: 0; width: 100%; height: 2000px;
    background: linear-gradient(#444 95%, #666 100%);
    background-size: 100% 100px;
    transform: rotateX(70deg); transform-origin: bottom;
    animation: drive var(--road-speed) linear infinite;
}
@keyframes drive { from { background-position: 0 0; } to { background-position: 0 1000px; } }

/* 4. The Player & Gold Evolution */
#player {
    position: absolute; bottom: 120px; left: 50%;
    transform: translateX(-50%); font-size: 80px;
    transition: left 0.2s ease, transform 0.3s;
    z-index: 10;
}

.gold-active {
    filter: drop-shadow(0 0 15px #fff) drop-shadow(0 0 30px #ffd700);
    transform: translateX(-50%) scale(1.5) translateY(-10px) !important;
}

.gold-active::after {
    content: "✨💖"; position: absolute; top: -20px; left: 50%;
    animation: float-up 1s infinite; font-size: 30px;
}
@keyframes float-up { 0% { opacity: 1; transform: translate(-50%, 0); } 100% { opacity: 0; transform: translate(-50%, -50px); } }

/* 5. The Clothing Gates */
.gate {
    position: absolute;
    width: 60px; height: 60px;
    background: rgba(255, 255, 255, 0.4);
    border: 3px solid white;
    border-radius: 10px;
    display: flex; justify-content: center; align-items: center;
    font-size: 30px;
    transition: transform 0.1s linear;
}

/* 6. Weather Overlays */
.cold-mode { background: linear-gradient(to bottom, #2c3e50, #000046); }
.cold-mode #road { background: linear-gradient(#a5c9e1 95%, #ffffff 100%); }
